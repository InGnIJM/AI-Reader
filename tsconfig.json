{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@ai-reader/shared": ["./packages/shared/src"],
      "@ai-reader/core": ["./packages/core/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
