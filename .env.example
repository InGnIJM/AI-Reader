# OpenAI-compatible model configuration for local development.
# Copy this file to `.env` and fill in your own values.
# Do not commit `.env`.

# Required for real model verification.
LLM_API_KEY=your_api_key_here

# OpenAI-compatible Chat Completions base URL.
# Examples:
# - OpenAI: https://api.openai.com/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model name sent to /v1/chat/completions.
# Examples:
# - gpt-4o-mini
# - deepseek-chat
# - qwen2.5:7b
LLM_MODEL=gpt-4o-mini

# Optional tuning knobs reserved for the code-analysis harness.
# These are not wired yet; they document the intended configuration surface.
CODE_ANALYSIS_MAX_TOOL_CALLS=15
CODE_ANALYSIS_MAX_FILE_CHARS=20000
CODE_ANALYSIS_MAX_TOOL_RESULT_CHARS=4000
